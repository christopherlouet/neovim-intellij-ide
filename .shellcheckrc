# ShellCheck configuration for neovim-intellij-ide
# https://github.com/koalaman/shellcheck/wiki/Directive

# Follow sourced files (e.g., /etc/os-release)
external-sources=true

# Shell dialect
shell=bash

# Disabled checks with justification:
# SC2034 - Variable appears unused (intentional in some install patterns)
disable=SC2034
