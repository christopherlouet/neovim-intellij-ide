# Shellcheck configuration
# Disable specific checks that are not critical

# SC2034 - Variable appears unused (often used in install scripts)
disable=SC2034

# SC2154 - Variable is referenced but not assigned (dynamic variables)
disable=SC2154

# SC2016 - Expressions don't expand in single quotes (intentional for run functions)
disable=SC2016

# SC2294 - eval with arrays (necessary for some script patterns)
disable=SC2294

# SC2027 - Surrounding quotes unquote (complex quoting patterns)
disable=SC2027

# SC2086 - Double quote to prevent globbing (intentional in some cases)
disable=SC2086

# SC2015 - A && B || C is not if-then-else (intentional pattern)
disable=SC2015
