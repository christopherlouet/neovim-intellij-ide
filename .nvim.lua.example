-- .nvim.lua.example - Exemple de configuration projet
-- Copiez ce fichier en .nvim.lua et adaptez-le à votre projet
--
-- IMPORTANT: Ce fichier sera exécuté uniquement si vous faites
-- confiance au projet avec :ProjectConfig trust

-- =============================================================
-- OPTIONS LOCALES
-- =============================================================

-- Indentation (décommentez selon vos besoins)
-- vim.opt_local.tabstop = 4
-- vim.opt_local.shiftwidth = 4
-- vim.opt_local.expandtab = true  -- spaces (false = tabs)

-- =============================================================
-- VARIABLES DE PROJET
-- =============================================================

vim.g.project_name = "my-project"
-- vim.g.project_type = "python"  -- ou "javascript", "go", etc.

-- =============================================================
-- KEYMAPS PROJET
-- =============================================================

-- Tests
vim.keymap.set("n", "<leader>pt", function()
  -- Adaptez cette commande à votre projet
  -- vim.cmd("!npm test")
  -- vim.cmd("!pytest")
  -- vim.cmd("!go test ./...")
  vim.notify("Configure test command in .nvim.lua", vim.log.levels.INFO)
end, { desc = "[P]roject [T]est" })

-- Build
vim.keymap.set("n", "<leader>pb", function()
  -- vim.cmd("!npm run build")
  -- vim.cmd("!make")
  -- vim.cmd("!go build")
  vim.notify("Configure build command in .nvim.lua", vim.log.levels.INFO)
end, { desc = "[P]roject [B]uild" })

-- Dev server
vim.keymap.set("n", "<leader>pd", function()
  -- vim.cmd("!npm run dev")
  -- vim.cmd("!python manage.py runserver")
  vim.notify("Configure dev command in .nvim.lua", vim.log.levels.INFO)
end, { desc = "[P]roject [D]ev" })

